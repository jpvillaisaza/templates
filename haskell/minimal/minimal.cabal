cabal-version: 3.16

name: minimal
version: 0.1.0.0

common extensions
  default-language: GHC2024

common ghc-options
  ghc-options:
    -Wall
    -Widentities

common rts-options
  ghc-options:
    -rtsopts
    -threaded
    -with-rtsopts=-N

library
  import:
    , extensions
    , ghc-options
  hs-source-dirs: src
  exposed-modules:
    Minimal
  build-depends:
    , base ^>= 4.22.0.0

test-suite minimal-test
  import:
    , extensions
    , ghc-options
    , rts-options
  hs-source-dirs: test
  main-is: Main.hs
  build-depends:
    , base
    , minimal
